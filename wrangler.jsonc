{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ozilgoal-aivideo",
  "main": "worker.ts",
  "account_id": "8021c9867ba6881cf688f0a25af0d32f",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ozilgoal-aivideo"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ozilgoal-aivideo-db",
      "database_id": "cf75b0ac-65e8-4a04-829f-9ea81e047abc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ozilgoal-aivideo-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://ozilgoal-aivideo.com",
    "PAYMENT_PROVIDER": "stripe",
    "STRIPE_MODE": "live",
    "STRIPE_PRICE_STARTER": "price_1UQqJp6L8rs4JTjQ3gDIlnUA",
    "STRIPE_PRICE_CREATOR": "price_1UQqJp6L8rs4JTjQlzvNyq5c",
    "STRIPE_PRICE_PRO": "price_1UQqJp6L8rs4JTjQKbZMkKys",
    "STRIPE_PRICE_BUSINESS": "price_1UQqJp6L8rs4JTjQ4NwBCYax",
    "KIE_MEDIA_HOSTS": "tempfile.aiquickdraw.com",
    "FAL_MEDIA_HOSTS": "fal.media,v3.fal.media,v3b.fal.media"
  },
  "workers_dev": true,
  "preview_urls": false
}
