# Local development only. Production values belong in the independent
# ozilgoal-aivideo Cloudflare Worker, never in Git.
APP_URL=http://127.0.0.1:3000

# D1 (DB), R2 (MEDIA), and ASSETS are Wrangler bindings.
# Email/password registration works without Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate at least 32 random characters for signed media URLs.
MEDIA_SIGNING_SECRET=

# Ozil Goal uses MiniMax H3 through fal.ai. Kie is retained for the existing
# fallback provider code. SeeAPI reviews generated video before delivery.
FAL_KEY=
FAL_MEDIA_HOSTS=fal.media,v3.fal.media,v3b.fal.media
KIE_API_KEY=
KIE_MEDIA_HOSTS=tempfile.aiquickdraw.com
SEEAPI_API_KEY=

# Four unchanged one-time USD credit packs: $9.90/300, $29.90/1200,
# $49.90/2200, and $99.90/5000. Test and live IDs/keys must never be mixed.
PAYMENT_PROVIDER=stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Webhook: https://ozilgoal-aivideo.com/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded, refund.created, refund.updated, refund.failed,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed.
